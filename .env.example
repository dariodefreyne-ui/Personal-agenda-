# Copy to .env and fill in. .env is git-ignored.

# --- Garmin Connect ---
# Preferred: run `python -m garmin.auth` once, copy the printed token blob into
# GARMIN_TOKENS_BASE64 (locally and as a GitHub Actions secret). MFA-proof.
GARMIN_TOKENS_BASE64=

# Fallback only (no MFA accounts): plain credentials.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Where token files live locally (default: ~/.garminconnect)
GARMIN_TOKENSTORE=
# Set to true only for Garmin Connect China (garmin.cn)
GARMIN_IS_CN=false

# --- Firestore ---
# In CI: paste the full service-account JSON as one secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Locally: path to the service-account file instead (one of the two).
GOOGLE_APPLICATION_CREDENTIALS=
# Your Firebase / GCP project id.
FIRESTORE_PROJECT_ID=
# Logical owner of the data; documents live under users/{FIRESTORE_USER_ID}.
FIRESTORE_USER_ID=dario
